# ───────────────────────── Ebooking Ticket — environment ─────────────────────────
# Copy to `.env` for local development. NEVER commit real secrets.
# All variables are read by the API only (apps/api). Nothing here is exposed to the browser.

# API server
API_PORT=8787
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Database
#   empty DATABASE_URL  → embedded PostgreSQL (PGlite) for local development
#   PGLITE_DATA_DIR     → persist local data between restarts (empty = in-memory)
#   Supabase/Postgres   → set DATABASE_URL to the pooled connection string (server-side only)
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# Auth  (secrets: leave EMPTY locally → random per process; REQUIRED, >= 32 random chars, in production)
#   AUTH_MODE=local     → built-in demo auth (scrypt passwords, HS256 JWT) for local development
#   AUTH_MODE=supabase  → Supabase Auth issues tokens; set SUPABASE_JWT_SECRET to the project's JWT secret
AUTH_MODE=local
JWT_SECRET=
# SUPABASE_JWT_SECRET=  (set only when AUTH_MODE=supabase; >= 32 chars)

# Ticket QR signing (HMAC) — rotate per environment
TICKET_SIGNING_SECRET=

# Payments: only the deterministic demo simulator is implemented. Real providers stay disabled
# until a provider and sandbox credentials are explicitly approved.
PAYMENT_PROVIDER=demo
DEMO_WEBHOOK_SECRET=

# Optional AI (natural-language seat intent fallback). The app works fully with AI_PROVIDER=none.
# AI_PROVIDER: none | gemini | openai | claude
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=8000
AI_MAX_REQ_PER_HOUR=30

# Booking rules
HOLD_TTL_SECONDS=600
PAYMENT_WINDOW_SECONDS=900
RATE_LIMIT_PER_MINUTE=300

# Set to true ONLY behind a trusted reverse proxy / CDN (rate limiting then uses X-Forwarded-For)
TRUST_PROXY=false

# Demo data: auto-seeded only for the local embedded DB outside production.
# SEED_DEMO_DATA=true seeds a non-production external DB once; it is refused in production.
SEED_DEMO_DATA=false
# Production refuses AUTH_MODE=local (demo auth) unless this is true (private demo deployments only)
ALLOW_DEMO_AUTH=false
