{
  "name": "ebooking-ticket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w @ebooking/api\" \"npm run dev -w @ebooking/web\"",
    "build": "npm run build -w @ebooking/web",
    "typecheck": "tsc -p packages/shared && tsc -p packages/seatvision && tsc -p packages/booking-engine && tsc -p apps/api && tsc -p apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:reset": "npm run db:reset -w @ebooking/api",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
